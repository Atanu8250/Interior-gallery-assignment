# .dockerignore for frontend - Excludes unnecessary files from Docker build

# Dependencies (installed in container)
node_modules/

# Build output (generated in container)
.next/
out/
build/

# Git files
.git/
.gitignore

# Environment files (use docker-compose.yml for env vars)
.env
.env.local
.env.*.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Development files
.turbo/
tsconfig.tsbuildinfo

# Testing (if added later)
coverage/
.jest/
